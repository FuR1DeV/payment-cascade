# Copy to .env and fill in. Everything works without it (mock providers only).

# Stripe TEST mode only. Live keys (sk_live_...) are rejected at startup.
# Dashboard -> Developers -> API keys (test mode).
STRIPE_SECRET_KEY=
# Only needed to receive Stripe webhooks (stripe listen --forward-to ...), see README.
STRIPE_WEBHOOK_SECRET=

# Host ports, if 8080 / 9000 are busy.
# API_PORT=8080
# MOCK_PSP_PORT=9000
